#
# Environment for the PaddleOCR broader-toolkit AMD GPU (ROCm) Compose deployment.
# Edit PIPELINE to switch the served pipeline. Valid values include:
#   OCR              -- general OCR (PP-OCRv6 det/rec/cls)
#   PP-StructureV3   -- layout + table + formula structure parsing
#   PP-DocTranslation-- document translation (may pull an additional LLM model)

# Local image tag built from Dockerfile (docker compose build).
IMAGE=paddleocr-toolkit:amd-gpu

# ROCm PaddlePaddle wheel pinned to the delivered amd-paddlepaddle build.
AMD_PADDLE_VERSION=3.4.0.dev20260825
AMD_PADDLE_INDEX_URL=https://pypi.amd.com/rocm-10.1/simple

# Pipeline to serve.
PIPELINE=OCR

# Host port to expose the pipeline service on.
SERVE_PORT=8080

# GPU selection (AMD Instinct). Set to the index of the card to use.
HIP_VISIBLE_DEVICES=0
